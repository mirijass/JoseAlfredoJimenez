# This is a .gitignore file for Unity projects
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]serSettings/

# MemoryCaptures can get large and are generally not necessary to commit
/[Mm]emoryCaptures/

# Assetly generated meta files can sometimes be ignored, but usually they are tracked.
# (Leave .meta files tracked so Unity doesn't lose asset references)

# Visual Studio / MonoDevelop / Rider generated files
/[Ee]xperimental/
.vs/
.unityproj
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# Autogenerated JetBrains Rider plugin
Assets/Plugins/Editor/JetBrains*

# OS specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Vuforia specific cache / temp files (useful since you are using Vuforia)
.qcar/
# Ignorar carpetas de compilación y APKs
/APK/
/Packages/*.tgz